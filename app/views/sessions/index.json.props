json.sessions do
  json.meta do
    json.currentPage @sessions.current_page
    json.perPage @sessions.limit_value
    json.totalItems @sessions.total_count
    json.totalPages @sessions.total_pages
  end
  json.links do
    json.self Kaminari::Helpers::Tag.new(self, params: { page: @sessions.current_page, format: nil }).page_url_for @sessions.current_page
    json.next path_to_next_page(@sessions, format: nil)
    json.previous path_to_prev_page(@sessions, format: nil)
  end
  json.data(partial: ["sessions/sessions_list", fragment: "sessions_list"]) do
  end
end

json.sessionSummary do
  session_count = Current.user.sessions.count
  ascent_count = Current.user.sessions.joins(:ascents).count

  json.totalSessions session_count
  json.totalAscents ascent_count
  json.averageAscents session_count == 0 ? 0 : (ascent_count / session_count).round(2)
end

json.statisticsPath statistics_path

pagination_params = { page: params[:page], per_page: params[:per_page] }.compact.transform_values(&:to_i)
json.createSessionModal do
  if @show_modal
    json.newSessionForm do
      # TODO: Can't use "props_at: 'data.createSessionModal.newSessionForm'" as it breaks in the redirect scenario
      form_props(model: @session, url: sessions_path(@session, **pagination_params)) do |f|
        f.text_area :description
        f.select :intent, Session.intents.map { |label, _v| [label.humanize, label] }, selected: Session.intents.first
        f.submit "Add"
      end
    end
    json.backPath sessions_path(**pagination_params)
  end
  json.showModal @show_modal
end

json.newSessionPath new_session_path(**pagination_params, props_at: 'data.createSessionModal')

json.weeklyActivity do
  first_session = Current.user.sessions.order(:created_at).first

  if first_session
    today = Date.today
    start_of_current_week = today.beginning_of_week(:monday)
    first_week_start = first_session.created_at.to_date.beginning_of_week(:monday)

    num_weeks = ((start_of_current_week - first_week_start) / 7).to_i + 1
    weeks = num_weeks.times.map do |i|
      week_start = first_week_start + i.weeks
      { start: week_start, end: week_start.end_of_week(:monday) }
    end

    session_weeks = Current.user.sessions
      .pluck(:created_at)
      .map { |t| t.to_date.beginning_of_week(:monday) }
      .to_set

    # Group sessions by week start (Monday) - database agnostic approach
    session_counts = {}
    Current.user.sessions.pluck(:created_at).each do |created_at|
      week_start = created_at.to_date.beginning_of_week(:monday)
      session_counts[week_start] = (session_counts[week_start] || 0) + 1
    end

    json.array! weeks do |week|
      json.weekStart week[:start].iso8601
      json.hasSession session_weeks.include?(week[:start])
      json.sessionCount session_counts[week[:start]] || 0
    end
  else
    json.array! []
  end
end

json.climbsOverTime do
  # Database-agnostic approach: fetch data and group in Ruby
  ascents = Current.user.sessions.joins(:ascents)
    .select('ascents.color, ascents.created_at')
    .where(ascents: { completed: true })

  rows_by_date = {}
  ascents.each do |ascent|
    date = ascent.created_at.to_date.to_s
    color = Ascent.colors.key(ascent.color) || ascent.color.to_s

    rows_by_date[date] ||= {}
    rows_by_date[date][color] = (rows_by_date[date][color] || 0) + 1
  end

  all_dates = rows_by_date.keys.sort

  json.daily do
    json.array! all_dates do |date|
      day_counts = rows_by_date[date] || {}
      json.date date
      Ascent.colors.each_key { |color| json.set! color, day_counts[color] || 0 }
    end
  end

  json.cumulative do
    color_totals = {}
    Ascent.colors.each_key { |c| color_totals[c] = 0 }

    json.array! all_dates do |date|
      day_counts = rows_by_date[date] || {}
      Ascent.colors.each_key { |c| color_totals[c] += day_counts[c] || 0 }
      json.date date
      Ascent.colors.each_key { |color| json.set! color, color_totals[color] }
    end
  end
end
