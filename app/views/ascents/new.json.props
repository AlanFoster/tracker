json.newAscentForm do
  form_props(model: @ascent, url: session_ascents_path(@session)) do |f|
    f.select :color, Ascent.colors.keys
    f.text_field :tries
    f.collection_check_boxes :tags, Ascent::AVAILABLE_TAGS, :to_s, :titleize
    f.submit "Add"
  end
end

json.backPath session_path(@ascent.session)
